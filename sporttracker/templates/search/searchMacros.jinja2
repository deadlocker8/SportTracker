{% import 'macros.jinja2' as macros with context %}
{% import 'workout/workoutMacros.jinja2' as workoutMacros with context %}

{% macro searchFilterSectionHeader(icon, title) -%}
    <div class="d-flex align-items-center justify-content-center">
        <span class="material-symbols-outlined fs-5">{{ icon }}</span>
        <span class="ms-2">{{ title }}</span>
    </div>
{%- endmacro %}

{% macro searchFilterText(searchText) -%}
    {{ searchFilterSectionHeader('search', gettext('Search')) }}

    <div class="d-flex flex-column align-items-start justify-content-center px-1 w-100">
        <div class="text-nowrap mb-2 w-100">
            <input class="form-control" type="search"
                   id="searchFilterText"
                   name="searchText"
                   value="{{ searchText | e }}">
        </div>
    </div>
{%- endmacro %}

{% macro searchFilterYearAndMonth(availableYears, monthNames, selectedYear, selectedMonth) -%}
    {{ searchFilterSectionHeader('filter_alt', gettext('Year & Month')) }}

    <div class="d-flex flex-column align-items-start justify-content-center px-1 w-100">
        <select class="form-select mb-2" id="searchFilterYear" name="year">
            <option value="">{{ gettext('All years') }}</option>
            {% for availableYear in availableYears %}
                <option value="{{ availableYear }}" {% if selectedYear == availableYear %}selected{% endif %}>{{ availableYear }}</option>
            {% endfor %}
        </select>

        <select class="form-select" id="searchFilterMonth" name="month">
            <option value="">{{ gettext('All months') }}</option>
            {% for monthName in monthNames %}
                <option value="{{ loop.index }}" {% if selectedMonth == loop.index %}selected{% endif %}>{{ monthName }}</option>
            {% endfor %}
        </select>
    </div>
{%- endmacro %}

{% macro searchFilterParticipants(participants, selectedParticipantIds, isParticipantFilterActive) -%}
    {{ searchFilterSectionHeader('filter_alt', gettext('Participants')) }}

    <div class="d-flex flex-column align-items-start justify-content-center px-1">
        <input type="hidden" name="participantsFilterActive" value="1">

        <div class="form-check text-nowrap mb-2">
            <input class="form-check-input" type="checkbox"
                   id="searchFilterAnyParticipant"
                   name="anyParticipant"
                   value="1"
                   {% if not isParticipantFilterActive %}checked{% endif %}>
            <label class="form-check-label" for="searchFilterAnyParticipant">
                {{ gettext('Any participant') }}
            </label>
        </div>

        {% for participant in participants %}
            <div class="form-check text-nowrap {% if not loop.last %}mb-2{% endif %}">
                <input class="form-check-input search-filter-participant-checkbox" type="checkbox"
                       id="searchFilterParticipant-{{ participant.id }}"
                       name="participants"
                       value="{{ participant.id }}"
                       {% if not isParticipantFilterActive or participant.id in selectedParticipantIds %}checked{% endif %}
                       {% if not isParticipantFilterActive %}disabled{% endif %}>
                <label class="form-check-label" for="searchFilterParticipant-{{ participant.id }}">
                    {{ participant.name | e }}
                </label>
            </div>
        {% endfor %}

        {% if not participants %}
            <div class="d-flex align-items-center input-field-margin">
                <span class="material-symbols-outlined fs-4 me-2">info</span>
                <span>{{ gettext('No participants available') }}</span>
            </div>
        {% endif %}
    </div>
{%- endmacro %}

{% macro searchFilterEquipment(equipmentGroupsByWorkoutType, selectedEquipmentIds, isEquipmentFilterActive) -%}
    {{ searchFilterSectionHeader('apparel', gettext('Equipment')) }}

    <div class="d-flex flex-column align-items-start justify-content-center px-1 w-100" id="search-equipment">
        <input type="hidden" name="equipmentFilterActive" value="1">

        <div class="form-check text-nowrap mb-3">
            <input class="form-check-input" type="checkbox" id="searchFilterAllEquipment" name="allEquipment" value="1" {% if not isEquipmentFilterActive %}checked{% endif %}>
            <label class="form-check-label" for="searchFilterAllEquipment">
                {{ gettext('All equipment') }}
            </label>
        </div>

        <div id="search-equipment-hidden-inputs">
            {% for equipmentId in selectedEquipmentIds %}
                <input type="hidden" name="equipment_ids" value="{{ equipmentId }}">
            {% endfor %}
        </div>

        <div class="d-flex flex-row flex-lg-column align-items-start gap-3">
            <div class="badge rounded-pill text-bg-secondary d-flex flex-row px-3 lh-lg {% if not isEquipmentFilterActive %}opacity-50{% endif %}" id="search-equipment-selected-container" {% if not isEquipmentFilterActive %}aria-disabled="true"{% endif %}>
                <div id="search-equipment-selected-count">{{ selectedEquipmentIds | length }}</div>
                <div class="ms-1">{{ gettext('selected') }}</div>
            </div>

            <button type="button" class="btn btn-primary btn-sm d-flex align-items-center button-automatically-disabled" data-bs-toggle="modal" data-bs-target="#search-equipment-modal" id="buttonSearchEquipmentSelect" {% if not isEquipmentFilterActive %}disabled{% endif %}>
                <span class="material-symbols-outlined filled fs-4 me-2">apparel</span>{{ gettext('Select equipment') }}
            </button>
        </div>

        {{ workoutMacros.workout_equipment_modal([], selectedEquipment=[], equipmentPresets=[], modalId='search-equipment-modal', showPresets=false, selectedEquipmentIds=selectedEquipmentIds, showInactive=true, workoutTypeGroups=equipmentGroupsByWorkoutType) }}
    </div>
{%- endmacro %}

{% macro searchFilterDistance(distanceMin, distanceMax) -%}
    {{ searchFilterSectionHeader('filter_alt', gettext('Distance (in km)')) }}

    <div class="d-flex flex-row align-items-center justify-content-center px-1">
        <div class="text-nowrap w-100">
            <input class="form-control"
                   type="number" min="0"
                   id="searchFilterDistanceMin"
                   name="distanceMin"
                   value="{% if distanceMin is not none %}{{ distanceMin }}{% endif %}">
        </div>

        <span class="my-2 my-md-0 mx-2">{{ gettext('to') }}</span>

        <div class="text-nowrap w-100">
            <input class="form-control"
                   type="number" min="0"
                   id="searchFilterDistanceMax"
                   name="distanceMax"
                   value="{% if distanceMax is not none %}{{ distanceMax }}{% endif %}">
        </div>
    </div>
{%- endmacro %}

{% macro searchFilter(searchParameters, resetUrl, classes='mt-2') -%}
    <form class="{{ classes }}" method="GET" action="{{ url_for('search.performSearch') }}"
          onsubmit="return automaticallyDisableButtonsOnFormSubmit(this);">
        <div class="d-flex align-items-center justify-content-center gap-2 py-3">
            <a href="{{ resetUrl }}" id="buttonResetSearchFilter" class="btn btn-sm btn-outline-danger text-nowrap">{{ gettext('Reset') }}</a>

            {{ macros.buttonSubmitAutomaticallyDisabled(text=gettext('Search'), disabledText=gettext('Searching...'), icon=none, classes='btn-sm btn-primary text-nowrap', id='buttonApplySearchFilter') }}
        </div>

        <div class="my-3 d-flex flex-column align-items-start justify-content-start gap-3 overflow-x-auto">
            <hr class="w-100 my-0"/>

            {{ searchFilterText(searchParameters.searchText) }}
            <hr class="w-100 my-0"/>

            {{ searchFilterYearAndMonth(searchParameters.availableYears, searchParameters.get_month_names(), searchParameters.selectedYear, searchParameters.selectedMonth) }}
            <hr class="w-100 my-0"/>

            {{ searchFilterParticipants(searchParameters.participants, searchParameters.selectedParticipantIds, searchParameters.isParticipantFilterActive) }}
            <hr class="w-100 my-0"/>

            {{ searchFilterEquipment(searchParameters.equipmentGroupsByWorkoutType, searchParameters.selectedEquipmentIds, searchParameters.isEquipmentFilterActive) }}
            <hr class="w-100 my-0"/>

            {{ searchFilterDistance(searchParameters.distanceMin, searchParameters.distanceMax) }}
            <hr class="w-100 my-0"/>
        </div>
    </form>
{%- endmacro %}
