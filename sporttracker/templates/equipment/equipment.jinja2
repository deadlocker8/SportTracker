<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>SportTracker - {{ gettext('Equipment') }}</title>
        {% import 'macros.jinja2' as macros with context %}
        {{ macros.header() }}
    </head>
    <body class="bg-dark text-light">
        {{ macros.navbar('equipment') }}
        {% import 'workout/workoutMacros.jinja2' as workoutMacros with context %}
        {% import 'equipment/equipmentMacros.jinja2' as equipmentMacros with context %}

        <div id="main" class="center-align">
            <section class="py-5 text-center container">
                <div class="row">
                    <div class="col col-12 mx-auto">
                        {% call macros.headline(gettext('Equipment')) %}
                            <span class="material-symbols-outlined filled fs-1">apparel</span>
                        {% endcall %}
                    </div>
                </div>

                <button id="buttonFilter" class="btn btn-sm {% if equipmentFilterState.is_any_filter_active() %}btn-light{% else %}btn-outline-light{% endif %} d-inline-flex align-items-center" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvas">
                    <span class="material-symbols-outlined fs-5">filter_alt</span>
                    <span class="ms-2">{{ gettext('Filter') }}</span>
                </button>

                {% for workoutType, groups in equipmentGroupsByWorkoutType.items() %}
                    <div class="row mt-5 mb-3">
                        <div class="col col-12 mx-auto">
                            <h3 class="d-flex align-items-center justify-content-start">
                                {{ workoutMacros.workout_type_icon_small(workoutType, classes='me-3') }}
                                <span class="me-3">{{ workoutType.get_localized_name() }}</span>
                            </h3>
                        </div>
                    </div>

                    {% for group in groups %}
                        <div class="row py-3 row-cols-1 row-cols-md-2 row-cols-lg-3">
                            <div class="col mb-5">
                                <a href="{{ group.add_url }}" class="link-light text-decoration-none h-100 border border-white border-5 rounded equipment-new-border d-flex flex-column align-item-center justify-content-center gap-4 py-5">
                                    <div>
                                        {% if group.is_font_awesome_icon %}
                                            <i class="fa-solid {{ group.icon }} equipment-new-icon fa-fw"></i>
                                        {% else %}
                                            <span class="material-symbols-outlined filled equipment-new-icon">{{ group.icon }}</span>
                                        {% endif %}
                                    </div>
                                    <div class="fs-5">{{ group.add_text }}</div>
                                    <div>
                                        <span class="rounded-circle bg-primary p-1 fs-1 material-symbols-outlined">add</span>
                                    </div>
                                </a>
                            </div>

                            {% for item in group.items %}
                                <div class="col mb-5">
                                    <div class="card h-100">
                                        <div class="card-header mb-0">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div class="d-flex align-items-center text-truncate">
                                                    <div class="fs-5 text-truncate equipment-name px-2">
                                                        {{ item.equipment.name | e }}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <a href="{{ url_for('equipment.edit', equipment_id=item.equipment.id) }}" class="text-decoration-none bg-secondary d-flex align-items-center justify-content-center equipment-icon">
                                            {% if item.equipment.clothes_type %}
                                                <img class="icon-svg-small" src="{{ url_for('static', filename="images/clothes/" + item.equipment.clothes_type.icon_file_name) }}" />
                                            {% else %}
                                                {% if group.is_font_awesome_icon %}
                                                    <i class="fa-solid {{ group.icon }} fa-fw text-white"></i>
                                                {% else %}
                                                    <span class="material-symbols-outlined filled text-white">{{ group.icon }}</span>
                                                {% endif %}
                                            {% endif %}
                                        </a>

                                        <div class="card-body">
                                            <ol class="list-group list-group-flush">
                                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                                    <div>{{ gettext('Date of purchase:') }}</div>
                                                    <div class="fw-bold">{{ item.equipment.purchase_date | format_date() }}</div>
                                                </li>
                                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                                    <div>{{ gettext('Number of workouts:') }}</div>
                                                    <div class="fw-bold">{{ item.number_of_workouts }}</div>
                                                </li>
                                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                                    <div>{{ gettext('Total duration:') }}</div>
                                                    <div class="fw-bold">{{ item.total_duration | format_duration() }} h</div>
                                                </li>
                                                {% if item.total_distance is not none %}
                                                    <li class="list-group-item d-flex justify-content-between align-items-start">
                                                        <div>{{ gettext('Total distance:') }}</div>
                                                        <div class="fw-bold">{{ (item.total_distance / 1000) | format_decimal(2) }} km</div>
                                                    </li>
                                                {% endif %}
                                            </ol>
                                        </div>

                                        <div class="card-footer text-body-secondary d-flex align-items-center justify-content-between">
                                            {% if item.equipment.is_active %}
                                                <div class="badge rounded-pill text-bg-success d-flex align-items-center me-5">
                                                    <div class="material-symbols-outlined filled fs-5">check</div>
                                                    <div class="fs-6 fw-normal">&nbsp;{{ gettext('Active') }}</div>
                                                </div>
                                            {% else %}
                                                <div class="badge rounded-pill text-bg-secondary d-flex align-items-center me-2">
                                                    <div class="material-symbols-outlined fs-5">block</div>
                                                    <div class="fs-6 fw-normal">&nbsp;{{ gettext('Disabled') }}</div>
                                                </div>
                                            {% endif %}
                                            <a href="{{ url_for('equipment.edit', equipment_id=item.equipment.id) }}" class="btn btn-primary d-inline-flex align-items-center">
                                                <span class="material-symbols-outlined filled text-light fs-5">edit</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}
                    <hr>
                {% endfor %}
            </section>

            <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvas" data-bs-theme="dark">
                <div class="offcanvas-header pb-2 bg-dark text-white">
                    <h5 class="offcanvas-title mx-auto d-flex flex-row align-items-center justify-content-center">
                        <span class="material-symbols-outlined fs-5">filter_alt</span>
                        <span>{{ gettext('Filter') }}</span>
                    </h5>
                    <button type="button" class="btn-close ms-0" data-bs-dismiss="offcanvas" data-bs-theme="dark"></button>
                </div>
                <div class="offcanvas-body pt-0 bg-dark text-white">
                    {{ equipmentMacros.equipmentFilter(equipmentFilterState, url_for('equipment.listEquipment')) }}
                </div>
            </div>
        </div>

        {{ macros.scripts(plotly=true) }}
    </body>
</html>
