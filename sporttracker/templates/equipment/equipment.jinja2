<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>SportTracker - {{ gettext('Equipment') }}</title>
        {% import 'macros.jinja2' as macros with context %}
        {{ macros.header() }}
    </head>
    <body class="bg-dark text-light">
        {{ macros.navbar('equipment') }}
        {% import 'workout/workoutMacros.jinja2' as workoutMacros with context %}

        <div id="main" class="center-align">
            <section class="py-5 text-center container">
                <div class="row">
                    <div class="col col-12 mx-auto">
                        {% call macros.headline(gettext('Equipment')) %}
                            <span class="material-symbols-outlined filled fs-1">apparel</span>
                        {% endcall %}
                    </div>
                </div>

                {% if not equipmentGroupsByWorkoutType %}
                    <div class="row mt-3">
                        <div class="col col-12 mx-auto d-flex align-items-center justify-content-center">
                            <span class="material-symbols-outlined fs-4 me-2">info</span>
                            <span>{{ gettext('No equipments yet') }}</span>
                        </div>
                    </div>
                {% endif %}

                {% for workoutType, groups in equipmentGroupsByWorkoutType.items() %}
                    <div class="row mt-5 mb-3">
                        <div class="col col-12 mx-auto">
                            <h3 class="d-flex align-items-center justify-content-center">
                                {{ workoutMacros.workout_type_icon_small(workoutType, classes='me-3') }}
                                <span class="me-3">{{ workoutType.get_localized_name() }}</span>
                            </h3>
                        </div>
                    </div>

                    {% for group in groups %}
                        <div class="row">
                            <div class="col col-12 mx-auto">
                                {% call macros.headline(group.name, addUrl=url_for('equipment_clothes.add', workout_type=workoutType.name), size='fs-4') %}
                                    {% if group.is_font_awesome_icon %}
                                        <i class="fa-solid {{ group.icon }} fs-3 fa-fw"></i>
                                    {% else %}
                                        <span class="material-symbols-outlined filled fs-3">{{ group.icon }}</span>
                                    {% endif %}
                                {% endcall %}
                            </div>
                        </div>

                        {% for item in items %}
                            <div>{{ item.name }} - {{ item.purchase_date }}</div>

                        {% endfor %}
                    {% endfor %}
                {% endfor %}
            </section>
        </div>

        {{ macros.scripts(plotly=true) }}
    </body>
</html>
