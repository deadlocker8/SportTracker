<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>SportTracker - {{ gettext('Equipment') }}</title>
        {% import 'macros.jinja2' as macros with context %}
        {{ macros.header() }}
    </head>
    <body class="bg-dark text-light">
        {{ macros.navbar('equipment') }}
        {% import 'workout/workoutMacros.jinja2' as workoutMacros with context %}

        <div id="main" class="center-align">
            <section class="py-5 text-center container">
                <div class="row">
                    <div class="col col-12 mx-auto">
                        {% call macros.headline(gettext('Equipment')) %}
                            <span class="material-symbols-outlined filled fs-1">apparel</span>
                        {% endcall %}
                    </div>
                </div>

                {% for workoutType, groups in equipmentGroupsByWorkoutType.items() %}
                    <div class="row mt-5 mb-3">
                        <div class="col col-12 mx-auto">
                            <h3 class="d-flex align-items-center justify-content-center">
                                {{ workoutMacros.workout_type_icon_small(workoutType, classes='me-3') }}
                                <span class="me-3">{{ workoutType.get_localized_name() }}</span>
                            </h3>
                        </div>
                    </div>

                    {% for group in groups %}
                        <div class="row">
                            <div class="col col-12 mx-auto">
                                {% call macros.headline(group.name, addUrl=group.add_url, size='fs-4') %}
                                    {% if group.is_font_awesome_icon %}
                                        <i class="fa-solid {{ group.icon }} fs-3 fa-fw"></i>
                                    {% else %}
                                        <span class="material-symbols-outlined filled fs-3">{{ group.icon }}</span>
                                    {% endif %}
                                {% endcall %}
                            </div>
                        </div>

                        <table class="table table-dark">
                            <thead>
                                <tr>
                                    <th scope="col">{{ gettext('Name') }}</th>
                                    <th scope="col">{{ gettext('Purchase Date') }}</th>
                                    <th scope="col">{{ gettext('Is Active') }}</th>
                                    <th scope="col">{{ gettext('Action') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in group.items %}
                                    <tr>
                                        <td>{{ item.name | e }}</td>
                                        <td>{{ item.purchase_date }}</td>
                                        <td>{{ item.is_active }}</td>
                                        <td>
                                            <a href="{{ url_for('equipment.edit', equipment_id=item.id) }}"
                                               class="link-light text-decoration-none">
                                                <span class="p-1 fs-5 material-symbols-outlined filled">edit</span>
                                            </a>
                                            <a href=""
                                               class="link-light text-decoration-none"
                                               data-bs-toggle="modal" data-bs-target="#delete-modal-{{ item.id }}">
                                                <span class="p-1 fs-5 material-symbols-outlined filled">delete</span>
                                            </a>

                                            {% call macros.deleteModal(gettext('Delete Equipment?'), gettext('Do you really want to delete the equipment "%(name)s"?<br><br>The equipment will also be removed from all associated workouts.', name=item.name), item.id) %}
                                                {{ macros.buttonSubmitAutomaticallyDisabled(classes='btn btn-danger button-delete-modal-action', icon='delete', text=gettext('Delete'), disabledText=gettext('Deleting...'), dataUrl=url_for('equipment.delete', equipment_id=item.id)) }}
                                            {% endcall %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endfor %}
                {% endfor %}
            </section>
        </div>

        {{ macros.scripts(plotly=true) }}
    </body>
</html>
