{% macro equipment_icon(name, is_font_awesome_icon) -%}
    {% if is_font_awesome_icon %}
        <i class="fa-solid {{ name }} fs-3 fa-fw"></i>
    {% else %}
        <span class="material-symbols-outlined filled fs-3">{{ name }}</span>
    {% endif %}
{%- endmacro %}


{% macro equipment_header(workout_type, is_edit, text_new, text_edit, delete_url, icon_name, is_font_awesome_icon) -%}
    <div class="row">
        <div class="col col-12 mx-auto">
            <h3 class="d-flex align-items-center justify-content-center">
                {{ workoutMacros.workout_type_icon_small(workout_type, classes='me-3') }}
                <span class="me-3">{{ workout_type.get_localized_name() }}</span>
            </h3>
        </div>
    </div>

    <div class="row">
        <div class="col col-12 mx-auto">
            {% if is_edit %}
                {% call macros.headline(text_edit, size='fs-3') %}
                    {{ equipment_icon(icon_name, is_font_awesome_icon) }}
                {% endcall %}
                <button type="button" class="btn btn-danger mt-3 d-flex align-items-center mx-auto button-automatically-disabled" data-bs-toggle="modal" data-bs-target="#delete-modal-0">
                    <span class="material-symbols-outlined filled text-light">delete</span>&nbsp;{{ gettext('Delete') }}
                </button>

                {% call macros.deleteModal(gettext('Delete Equipment?'), gettext('Do you really want to delete this equipment?<br><br>The equipment will also be removed from all associated workouts.')) %}
                    {{ macros.buttonSubmitAutomaticallyDisabled(classes='btn btn-danger button-delete-modal-action', icon='delete', text=gettext('Delete'), disabledText=gettext('Deleting...'), dataUrl=delete_url) }}
                {% endcall %}
            {% else %}
                {% call macros.headline(text_new, size='fs-3') %}
                    {{ equipment_icon(icon_name, is_font_awesome_icon) }}
                {% endcall %}
            {% endif %}
        </div>
    </div>
{%- endmacro %}

{% macro equipment_form_name(equipment) -%}
    <div class="mb-3">
        <div class="form-group">
            <label for="equipment-name" class="form-label input-field-margin">{{ gettext('Name') }}</label>
            <div class="d-flex align-items-center">
                <span class="material-symbols-outlined filled me-3">article</span>
                <input type="text" class="form-control" id="equipment-name"
                       name="name" required="required"
                       {% if equipment %}value="{{ equipment.name | e }}"{% endif %}>
            </div>
        </div>
    </div>
{%- endmacro %}

{% macro equipment_form_purchase_date(equipment) -%}
    <div class="mb-3">
        <div class="row">
            <div class="col col-12">
                <label for="equipment-purchase-date" class="form-label input-field-margin">{{ gettext('Purchase Date') }}</label>
                <div class="d-flex align-items-center">
                    <span class="material-symbols-outlined filled me-3">event</span>
                    <input type="date" class="form-control" id="equipment-purchase-date" name="purchase_date" min="2000-01-01" value="{% if equipment %}{{ equipment.purchase_date }}{% endif %}">
                </div>
            </div>
        </div>
    </div>
{%- endmacro %}

{% macro equipment_form_is_active(equipment) -%}
    <div class="mb-3 mt-5">
        <div class="row">
            <div class="col col-12">
                <label for="equipment-active" class="form-label">
                    <div class="d-flex align-items-center">
                        <span class="material-symbols-outlined filled me-3">check</span>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                    {% if equipment %}
                                        {% if equipment.is_active %}checked{% endif %}
                                    {% else %}
                                   checked
                                    {% endif %}
                                   id="equipment-active-checkbox"
                                   name="is_active">
                            <label class="form-check-label" for="equipment-active-checkbox">
                                {{ gettext('Active') }}
                            </label>
                        </div>
                    </div>
                </label>

                <div class="input-field-margin {% if not equipment or equipment.is_active %} hidden{% endif %}" id="equipment-active">
                    <label for="equipment-inactive-date" class="form-label">{{ gettext('Inactive Since') }}</label>

                    <input type="date" class="form-control" id="equipment-inactive-date" name="inactive_date" min="2000-01-01" value="{% if equipment %}{{ equipment.inactive_date }}{% endif %}">
                </div>
            </div>
        </div>
    </div>
{%- endmacro %}


{% macro equipment_filter_enum(availableTypes, selectedTypes, title, identifier, isClothesType=false) -%}
    <div class="d-flex align-items-center justify-content-center">
        <span class="material-symbols-outlined fs-5">filter_alt</span>
        <span class="ms-2">{{ title }}</span>
    </div>

    <div class="d-flex flex-column align-items-start justify-content-center px-1">
        {% for availableType in availableTypes %}
            <div class="form-check text-nowrap {% if not loop.last %}mb-2{% endif %}">
                <input class="form-check-input" type="checkbox"
                       id="{{ identifier }}-{{ loop.index }}"
                       name="{{ identifier }}-{{ loop.index }}"
                       value="{{ availableType.name }}"
                       {% if availableType in selectedTypes %}checked{% endif %}>
                <label class="form-check-label d-flex align-items-center" for="{{ identifier }}-{{ loop.index }}">
                    {% if isClothesType %}
                        <img class="icon-svg-small invert me-1" src="{{ url_for('static', filename='images/clothes/' + availableType.icon_file_name) }}" alt="">
                    {% else %}
                        {% if availableType.is_font_awesome_icon %}
                            <i class="fa-solid {{ availableType.icon }} fs-5 me-1"></i>
                        {% else %}
                            <span class="material-symbols-outlined filled fs-5 me-1">{{ availableType.icon }}</span>
                        {% endif %}
                    {% endif %}
                    <span>{{ availableType.get_localized_name() }}</span>
                </label>
            </div>
        {% endfor %}
    </div>
{%- endmacro %}


{% macro equipment_filter_status(isActiveSelected, isInactiveSelected) -%}
    <div class="d-flex align-items-center justify-content-center">
        <span class="material-symbols-outlined fs-5">filter_alt</span>
        <span class="ms-2">{{ gettext('Status') }}</span>
    </div>

    <div class="d-flex flex-column align-items-start justify-content-center px-1">
        <div class="form-check text-nowrap mb-2">
            <input class="form-check-input" type="checkbox"
                   id="equipmentFilterStatusActive"
                   name="equipmentFilterStatusActive"
                   {% if isActiveSelected %}checked{% endif %}>
            <label class="form-check-label d-flex align-items-center" for="equipmentFilterStatusActive">
                <span class="material-symbols-outlined fs-5 me-1">check</span>
                <span>{{ gettext('Active') }}</span>
            </label>
        </div>
        <div class="form-check text-nowrap">
            <input class="form-check-input" type="checkbox"
                   id="equipmentFilterStatusInactive"
                   name="equipmentFilterStatusInactive"
                   {% if isInactiveSelected %}checked{% endif %}>
            <label class="form-check-label d-flex align-items-center" for="equipmentFilterStatusInactive">
                <span class="material-symbols-outlined fs-5 me-1">block</span>
                <span>{{ gettext('Disabled') }}</span>
            </label>
        </div>
    </div>
{%- endmacro %}


{% macro equipmentFilter(equipmentFilterState, redirectUrl, classes="mt-2") -%}
    <form class="{{ classes }}" method="POST" action="{{ url_for('equipment.applyFilter') }}"
          onsubmit="return automaticallyDisableButtonsOnFormSubmit(this);">
        <input type="hidden" name="redirectUrl" value="{{ redirectUrl }}">
        <div class="position-sticky top-0 z-1 bg-dark d-flex align-items-center justify-content-center gap-2 py-3">
            <a href="{{ url_for('equipment.resetFilter', redirectUrl=redirectUrl) }}" id="buttonResetFilter" class="btn btn-sm btn-outline-danger text-nowrap">{{ gettext('Reset') }}</a>

            {{ macros.buttonSubmitAutomaticallyDisabled(text=gettext('Apply'), disabledText=gettext('Applying...'), icon=none, classes='btn-sm btn-primary text-nowrap', id='buttonApplyFilter') }}
        </div>

        <div class="my-3 d-flex flex-column align-items-start justify-content-start gap-3 overflow-x-auto">
            <hr class="w-100 my-0"/>

            {{ equipment_filter_enum(equipmentTypes, equipmentFilterState.get_selected_equipment_types(), gettext('Equipment Type'), 'equipmentFilterEquipmentType') }}
            <hr class="w-100 my-0"/>

            {{ equipment_filter_enum(clothesTypes, equipmentFilterState.get_selected_clothes_types(), gettext('Clothes Type'), 'equipmentFilterClothesType', true) }}
            <hr class="w-100 my-0"/>

            {{ equipment_filter_status(equipmentFilterState.is_active_selected, equipmentFilterState.is_inactive_selected) }}
            <hr class="w-100 my-0"/>
        </div>
    </form>
{%- endmacro %}
