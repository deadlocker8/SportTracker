{% macro equipment_icon(name, is_font_awesome_icon) -%}
    {% if is_font_awesome_icon %}
        <i class="fa-solid {{ name }} fs-3 fa-fw"></i>
    {% else %}
        <span class="material-symbols-outlined filled fs-3">{{ name }}</span>
    {% endif %}
{%- endmacro %}


{% macro equipment_header(workout_type, is_edit, text_new, text_edit, delete_url, icon_name, is_font_awesome_icon) -%}
    <div class="row">
        <div class="col col-12 mx-auto">
            <h3 class="d-flex align-items-center justify-content-center">
                {{ workoutMacros.workout_type_icon_small(workout_type, classes='me-3') }}
                <span class="me-3">{{ workout_type.get_localized_name() }}</span>
            </h3>
        </div>
    </div>

    <div class="row">
        <div class="col col-12 mx-auto">
            {% if is_edit %}
                {% call macros.headline(text_edit, size='fs-3') %}
                    {{ equipment_icon(icon_name, is_font_awesome_icon) }}
                {% endcall %}
                <button type="button" class="btn btn-danger mt-3 d-flex align-items-center mx-auto button-automatically-disabled" data-bs-toggle="modal" data-bs-target="#delete-modal-0">
                    <span class="material-symbols-outlined filled text-light">delete</span>&nbsp;{{ gettext('Delete') }}
                </button>

                {% call macros.deleteModal(gettext('Delete Equipment?'), gettext('Do you really want to delete this equipment?<br><br>The equipment will also be removed from all associated workouts.')) %}
                    {{ macros.buttonSubmitAutomaticallyDisabled(classes='btn btn-danger button-delete-modal-action', icon='delete', text=gettext('Delete'), disabledText=gettext('Deleting...'), dataUrl=delete_url) }}
                {% endcall %}
            {% else %}
                {% call macros.headline(text_new, size='fs-3') %}
                    {{ equipment_icon(icon_name, is_font_awesome_icon) }}
                {% endcall %}
            {% endif %}
        </div>
    </div>
{%- endmacro %}

{% macro equipment_form_name(equipment) -%}
    <div class="mb-3">
        <div class="form-group">
            <label for="equipment-name" class="form-label input-field-margin">{{ gettext('Name') }}</label>
            <div class="d-flex align-items-center">
                <span class="material-symbols-outlined filled me-3">article</span>
                <input type="text" class="form-control" id="equipment-name"
                       name="name" required="required"
                       {% if equipment %}value="{{ equipment.name | e }}"{% endif %}>
            </div>
        </div>
    </div>
{%- endmacro %}

{% macro equipment_form_purchase_date(equipment) -%}
    <div class="mb-3">
        <div class="row">
            <div class="col col-12">
                <label for="equipment-purchase-date" class="form-label input-field-margin">{{ gettext('Purchase Date') }}</label>
                <div class="d-flex align-items-center">
                    <span class="material-symbols-outlined filled me-3">event</span>
                    <input type="date" class="form-control" id="equipment-purchase-date" name="purchase_date" min="2000-01-01"
                           required="required" value="{% if equipment %}{{ equipment.purchase_date }}{% endif %}">
                </div>
            </div>
        </div>
    </div>
{%- endmacro %}

{% macro equipment_form_is_active(equipment) -%}
    <div class="mb-3 mt-5">
        <div class="row">
            <div class="col col-6">
                <label for="equipment-active" class="form-label">
                    <div class="d-flex align-items-center">
                        <span class="material-symbols-outlined filled me-3">check</span>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                    {% if equipment %}
                                   {% if equipment.is_active %}checked{% endif %}
                                    {% else %}
                                   checked
                                    {% endif %}
                                   id="equipment-active-checkbox"
                                   name="is_active">
                            <label class="form-check-label" for="equipment-active-checkbox">
                                {{ gettext('Active') }}
                            </label>
                        </div>
                    </div>
                </label>
            </div>
        </div>
    </div>
{%- endmacro %}
