<!DOCTYPE html>

<html>
    <head>
        {% set isEdit = false %}
        {% if equipment and equipment.id is not none %}
            {% set isEdit = true %}
        {% endif %}

        <meta charset="UTF-8">
        <title>SportTracker - {% if isEdit %}{{ gettext('Edit Clothes') }}{% else %}
            {{ gettext('New Clothes') }}{% endif %}</title>
        {% import 'macros.jinja2' as macros with context %}
        {{ macros.header() }}
    </head>
    <body class="bg-dark text-light">
        {{ macros.navbar('equipments') }}
        {% import 'workout/workoutMacros.jinja2' as workoutMacros with context %}

        <div id="main" class="center-align">
            <section class="py-5 text-center container">
                <div class="row">
                    <div class="col col-12 mx-auto">
                        <h3 class="d-flex align-items-center justify-content-center">
                            {{ workoutMacros.workout_type_icon_small(workout_type, classes='me-3') }}
                            <span class="me-3">{{ workout_type.get_localized_name() }}</span>
                        </h3>
                    </div>
                </div>

                <div class="row">
                    <div class="col col-12 mx-auto">
                        {% if isEdit %}
                            {% call macros.headline(gettext('Edit Clothes')) %}
                                <i class="fa-solid fa-wrench fa-fw fs-2"></i>
                            {% endcall %}
                            <button type="button" class="btn btn-danger mt-3 d-flex align-items-center mx-auto button-automatically-disabled" data-bs-toggle="modal" data-bs-target="#delete-modal-0">
                                <span class="material-symbols-outlined filled text-light">delete</span>&nbsp;{{ gettext('Delete') }}
                            </button>

                            {% call macros.deleteModal(gettext('Delete Clothes?'), gettext('Do you really want to delete this equipment?<br><br>The equipment will also be removed from all associated workouts.')) %}
                                {{ macros.buttonSubmitAutomaticallyDisabled(classes='btn btn-danger button-delete-modal-action', icon='delete', text=gettext('Delete'), disabledText=gettext('Deleting...'), dataUrl=url_for('equipment_clothes.delete', equipment_id=equipment.id)) }}
                            {% endcall %}
                        {% else %}
                            {% call macros.headline(gettext('New Clothes')) %}
                                <i class="fa-solid fa-wrench fa-fw fs-2"></i>
                            {% endcall %}
                        {% endif %}
                    </div>
                </div>

                <div class="row mt-5 text-start">
                    <div class="col col-11 col-md-9 mx-auto">
                        <form role="form" action="{% if isEdit %}{{ url_for('equipment_clothes.editPost', equipment_id=equipment.id) }}{% else %}{{ url_for('equipment_clothes.addPost') }}{% endif %}"
                              onsubmit="return automaticallyDisableButtonsOnFormSubmit(this);"
                              method="post">

                            <input type="hidden" name="workout_type" value="{{ workout_type.name }}">

                            <div class="mb-3">
                                <label for="clothes-type" class="form-label input-field-margin">{{ gettext('Type') }}</label>
                                <div class="d-flex align-items-center">
                                    <span class="material-symbols-outlined filled me-3">stars</span>
                                    <select class="form-select" id="clothes-type" name="clothes_type" required="required">
                                        {% for clothesType in clothesTypes %}
                                            <option value="{{ clothesType.name }}"
                                                    {% if equipment and equipment.clothes_type == clothesType.name %}selected{% endif %}>{{ clothesType.get_localized_name() }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="form-group">
                                    <label for="equipment-name" class="form-label input-field-margin">{{ gettext('Name') }}</label>
                                    <div class="d-flex align-items-center">
                                        <span class="material-symbols-outlined filled me-3">article</span>
                                        <input type="text" class="form-control" id="equipment-name"
                                               name="name" required="required"
                                               {% if equipment %}value="{{ equipment.name | e }}"{% endif %}>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="row">
                                    <div class="col col-12">
                                        <label for="equipment-purchase-date" class="form-label input-field-margin">{{ gettext('Purchase Date') }}</label>
                                        <div class="d-flex align-items-center">
                                            <span class="material-symbols-outlined filled me-3">event</span>
                                            <input type="date" class="form-control" id="equipment-purchase-date" name="purchase_date" min="2000-01-01"
                                                   required="required" value="{% if equipment %}{{ equipment.purchase_date }}{% endif %}">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3 mt-5">
                                <div class="row">
                                    <div class="col col-6">
                                        <label for="equipment-active" class="form-label">
                                            <div class="d-flex align-items-center">
                                                <span class="material-symbols-outlined filled me-3">check</span>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox"
                                                           {% if equipment %}
                                                                {% if equipment.is_active %}checked{% endif %}
                                                           {% else %}
                                                                checked
                                                           {% endif %}
                                                           id="equipment-active-checkbox"
                                                           name="is_active">
                                                    <label class="form-check-label" for="equipment-active-checkbox">
                                                        {{ gettext('Active') }}
                                                    </label>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            {{ macros.buttonSubmitAutomaticallyDisabled(classes='mt-5 input-field-margin', id='buttonSaveEquipment') }}
                        </form>
                    </div>
                </div>
            </section>
        </div>

        {{ macros.scripts() }}
    </body>
</html>
