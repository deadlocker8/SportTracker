<!DOCTYPE html>

<html>
    <head>
        <meta charset="UTF-8">
        <title>SportTracker - {{ gettext('Tile Hunting') }}</title>
        {% import 'macros.jinja2' as macros with context %}
        {{ macros.header() }}
        <link type="text/css" rel="stylesheet" href="{{ url_for('static', filename="css/leaflet-theme.css") }}"/>
        <style>
            .leaflet-layer:first-child {
                -webkit-filter: grayscale(100%);
                filter: grayscale(100%);
            }
        </style>
    </head>
    <body class="bg-dark text-light">
        {{ macros.navbar('tileHunting') }}

        {% import 'map/mapMacros.jinja2' as mapMacros with context %}
        {{ mapMacros.mapLocale() }}

        <div class="row my-3 g-0">
            <div class="col col-12 mx-auto d-flex flex-wrap align-items-center justify-content-center gap-3 gap-xl-5">
                <button class="btn btn-sm {% if quickFilterState.is_any_filter_active() %}btn-light{% else %}btn-outline-light{% endif %} d-inline-flex align-items-center " type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvas">
                    <span class="material-symbols-outlined fs-5">filter_alt</span>
                    <span class="ms-2">{{ gettext('Filter') }}</span>
                </button>

                <div class="d-none d-lg-block">
                    {{ macros.workout_type_quick_filter(url_for(redirectUrl), true) }}
                </div>
                <div class="d-lg-none">
                    <div class="d-flex flex-column align-items-center justify-content-center">
                        {{ macros.workout_type_quick_filter(url_for(redirectUrl), true) }}
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 gap-md-3">
                    {{ mapMacros.tileHuntingMapSettings(tileHuntingFilterState,url_for('maps.showTileHuntingMap'), enableTilesOption=false, enableGridOption=true, enableNewTilesOption=false, enableMaxSquareOption=true, enableMaxClusterOption=true, enablePlannedTileOption=true, forceButtonText=true, classes="") }}
                    <h5 class="mb-0" id="warning-zoom">
                        <span class="badge text-bg-warning text-wrap">{{ gettext('Zoom in to view visited tiles.') }}</span>
                    </h5>
                </div>
            </div>
        </div>

        <!-- small displays -->
        <div class="card bg-body-secondary mx-3 mb-3 d-xl-none" data-bs-theme="dark">
            <div class="card-body ps-4 pt-4 pb-0">
                <div class="row row-cols-3 gy-3 pb-3 overflow-x-auto flex-nowrap">
                    {% call mapMacros.meta_info_item_small('explore', 'text-white', gettext('Tiles visited'), helpClass='button-help-tiles', helpText=gettext('Tiles are shown in their corresponding workout type color. If different workout types had visited a tile, it will be shown in <span class=&quot;text-danger fw-bold&quot;>red</span>.')) %}
                        {{ totalNumberOfTiles }}
                    {% endcall %}
                    {% call mapMacros.meta_info_item_small('arrows_output', 'text-white', gettext('Max square'), helpClass='button-help-max-square', helpText=gettext('The size of the maximum square area that is completely covered by your visited tiles. If the checkbox &quot;Show max square&quot; is selected all tiles inside your max square will use this color: <span class=&quot;d-inline-block&quot; style=&quot;width: 10px; height: 10px; background-color: {maxSquareColor};&quot;></span>').format(maxSquareColor=maxSquareColor)) %}
                        {{ maxSquareSize }}x{{ maxSquareSize }}
                    {% endcall %}
                    {% call mapMacros.meta_info_item_small('linked_services', 'text-white', gettext('Max cluster'), helpClass='button-help-max-cluster', helpText=gettext('The size of the largest connected area of visited tiles. Two tiles are considered connected if they share a common edge. If the checkbox &quot;Show max cluster&quot; is selected all tiles inside your max cluster will use this color: <span class=&quot;d-inline-block&quot; style=&quot;width: 10px; height: 10px; background-color: {maxClusterColor};&quot;></span>').format(maxClusterColor=maxClusterColor)) %}
                        {{ maxClusterSize }}
                    {% endcall %}
                </div>
            </div>
        </div>

        <div class="row mx-3 mx-xl-5">
            <div class="col col-12 col-xl-9 col-xxl-10 p-0">
                <div id="map" class="map-tile-hunting leaflet-map text-dark"></div>
            </div>

            <!-- large displays -->
            <div class="col col-3 col-xxl-2 p-0 ps-4 d-none d-xl-block">
                <div class="card bg-body-secondary h-100" data-bs-theme="dark">
                    <div class="card-body ps-4 pt-4">
                        {% call mapMacros.meta_info_item('explore', 'text-white', gettext('Tiles visited'), helpClass='button-help-tiles', helpText=gettext('Tiles are shown in their corresponding workout type color. If different workout types had visited a tile, it will be shown in <span class=&quot;text-danger fw-bold&quot;>red</span>.')) %}
                            {{ totalNumberOfTiles }}
                        {% endcall %}
                        {% call mapMacros.meta_info_item('arrows_output', 'text-white', gettext('Max square'), helpClass='button-help-max-square', helpText=gettext('The size of the maximum square area that is completely covered by your visited tiles. If the checkbox &quot;Show max square&quot; is selected all tiles inside your max square will use this color: <span class=&quot;d-inline-block&quot; style=&quot;width: 10px; height: 10px; background-color: {maxSquareColor};&quot;></span>').format(maxSquareColor=maxSquareColor)) %}
                            {{ maxSquareSize }}x{{ maxSquareSize }}
                        {% endcall %}
                        {% call mapMacros.meta_info_item('linked_services', 'text-white', gettext('Max cluster'), helpClass='button-help-max-cluster', helpText=gettext('The size of the largest connected area of visited tiles. Two tiles are considered connected if they share a common edge. If the checkbox &quot;Show max cluster&quot; is selected all tiles inside your max cluster will use this color: <span class=&quot;d-inline-block&quot; style=&quot;width: 10px; height: 10px; background-color: {maxClusterColor};&quot;></span>').format(maxClusterColor=maxClusterColor)) %}
                            {{ maxClusterSize }}
                        {% endcall %}
                    </div>
                </div>
            </div>
        </div>

        <div class="row gx-0 gy-0">
            <div class="col col-12">
                <div id="chartContainer" style="max-height: 22vh;"></div>
            </div>
        </div>

        <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvas" data-bs-theme="dark">
            <div class="offcanvas-header pb-2 bg-dark text-white">
                <h5 class="offcanvas-title mx-auto d-flex flex-row align-items-center justify-content-center">
                    <span class="material-symbols-outlined fs-5">filter_alt</span>
                    <span>{{ gettext('Filter') }}</span>
                </h5>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="offcanvas" data-bs-theme="dark"></button>
            </div>
            <div class="offcanvas-body pt-0 bg-dark text-white">
                {{ mapMacros.mapYearFilter(quickFilterState, url_for(redirectUrl)) }}
            </div>
        </div>

        <script>
            tileRenderUrl = '{{ tileRenderUrl }}';
            tileApiUrl = '{{ url_for("maps.tileOverlay") }}';
            mapMinZoomLevel = {{ mapMinZoomLevel }};
            baseZoomLevel = {{ baseZoomLevel }};
            isGridActive = {% if tileHuntingFilterState.is_show_grid_active %}true{% else %}false{% endif %};
        </script>

        {% import 'map/mapMacros.jinja2' as mapMacros with context %}
        {{ mapMacros.mapLocale() }}

        {{ macros.scripts(plotly=true, leaflet=true) }}
        <script defer src="{{ url_for('static', filename='js/mapCommon.js') }}" type="text/javascript"></script>
        <script defer src="{{ url_for('static', filename='js/mapTileHunting.js') }}" type="text/javascript"></script>
        <script defer src="{{ url_for('static', filename='js/quickFilter.js') }}" type="text/javascript"></script>
        <script>
            const data = [
                {
                    x: {{ chartDataNewTilesPerWorkout['dates'] }},
                    y: {{ chartDataNewTilesPerWorkout['values'] }},
                    type: 'bar',
                    marker: {
                        color: {{ chartDataNewTilesPerWorkout['colors'] }},
                        line: {
                            color: 'rgba(0, 0, 0, 0.7)',
                            width: 2
                        }
                    },
                    customdata: {{ chartDataNewTilesPerWorkout['names'] | tojson }},
                    hovertemplate: '+%{y} "%{customdata.name}"<br>({{ gettext("Click bar to open in new tab") }})<extra></extra>'
                },
            ];

            const plotlyLayout = {
                paper_bgcolor: 'rgba(0,0,0,0)',
                plot_bgcolor: 'rgba(0,0,0,0)',
                xaxis: {
                    type: 'category',
                    color: '#FFFFFF',
                    automargin: true,
                },
                yaxis: {
                    title: '{{ gettext('Number of new tiles') }}',
                    rangemode: 'tozero',
                    showline: true,
                    color: '#FFFFFF'
                },
                legend: {
                    font: {
                        color: '#FFFFFF'
                    }
                },
                margin: {
                    t: 30,
                }
            }

            const plotlyConfig = {
                responsive: true,
                displayModeBar: false
            };

            Plotly.newPlot('chartContainer', data, plotlyLayout, plotlyConfig);

            document.getElementById('chartContainer').on('plotly_click', function(data)
            {
                for(let i = 0; i < data.points.length; i++)
                {
                    window.open(data.points[i].customdata.url, '_blank');
                }
            });
        </script>
    </body>
</html>

